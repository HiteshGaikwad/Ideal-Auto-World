<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. If the requested URL is an existing file (like .js, .css, images), serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Otherwise, route everything internally to index.html with a 200 OK status
  RewriteRule ^ index.html [L]
</IfModule>